[Unit]
Description=YFFM3 dedicated match on UDP %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=yffm3
Group=yffm3
WorkingDirectory=/opt/yffm3/app/space-football-demo
EnvironmentFile=/etc/yffm3/%i.env
ExecStartPre=/opt/yffm3/bin/godot --headless --path /opt/yffm3/app/space-football-demo -- --verify-network-build
ExecStart=/opt/yffm3/bin/godot --headless --path /opt/yffm3/app/space-football-demo -- --server --port=%i
Environment=XDG_DATA_HOME=/var/lib/yffm3/%i
Environment=XDG_CACHE_HOME=/var/cache/yffm3/%i
StateDirectory=yffm3/%i
CacheDirectory=yffm3/%i
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0027
# Initial guard rails only; measure alongside Rougelite before raising capacity.
MemoryHigh=512M
MemoryMax=768M
CPUWeight=75
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
